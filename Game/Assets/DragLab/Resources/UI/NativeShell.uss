.shell {
    flex-grow: 1;
    background-color: var(--racing-background);
    color: var(--racing-text);
    font-size: 16px;
    -unity-font-definition: url("project://database/Assets/DragLab/Resources/UI/Fonts/BarlowCondensed-Medium.asset");
}
.hidden { display: none; }
.metal-background { position: absolute; left: 0; right: 0; top: 64px; bottom: 30px; overflow: hidden; }
.racing-surface { position: absolute; left: 0; top: 0; right: 0; bottom: 0; overflow: hidden; border-radius: 0; }
.nav-bar { flex-direction: row; height: 64px; flex-shrink: 0; align-items: stretch; background-color: #17191c; overflow: hidden; }
.brand { -unity-font-definition: url("project://database/Assets/DragLab/Resources/UI/Fonts/BarlowCondensed-BoldItalic.asset"); font-size: 22px; margin-left: 18px; margin-right: 18px; color: var(--racing-accent); -unity-text-align: middle-left; }
.destinations { flex-direction: row; align-items: stretch; }
.nav-button, .category-button, .settings-button {
    margin: 0;
    padding: 8px 12px;
    background-color: transparent;
    color: #dadddf;
    border-width: 1px;
    border-left-color: #53565d;
    border-right-color: #272c32;
    border-top-color: #74767d;
    border-bottom-color: #0b0d10;
    border-radius: 4px;
    overflow: hidden;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.nav-button { flex-direction: row; align-items: center; border-radius: 0; border-width: 0; font-size: 17px; -unity-font-definition: url("project://database/Assets/DragLab/Resources/UI/Fonts/BarlowCondensed-BoldItalic.asset"); }
.nav-button:hover, .category-button:hover, .settings-button:hover { background-color: rgba(255, 255, 255, 0.025); color: white; }
.nav-button:active, .category-button:active, .settings-button:active { background-color: rgba(0, 0, 0, 0.05); }
.nav-button.selected, .category-button.selected, .settings-button.selected { background-color: transparent; color: white; border-top-color: var(--racing-accent); border-bottom-color: var(--racing-accent); }
.nav-button.selected:hover, .category-button.selected:hover, .settings-button.selected:hover { background-color: rgba(255, 255, 255, 0.025); }
.resources { flex-direction: row; flex-grow: 1; justify-content: flex-end; align-items: center; margin-left: 12px; }
.resource { flex-direction: row; align-items: center; margin-left: 16px; translate: 0 -1px; }
.resource Label { font-size: 16px; translate: 0 -1px; }
.filled-icon { width: 22px; height: 22px; flex-shrink: 0; align-self: center; margin-right: 7px; }
.resource .filled-icon { width: 17px; height: 17px; margin-right: 6px; }
.inspection-space { width: 42px; flex-shrink: 0; }
.settings-button { width: 80px; height: 100%; margin-right: 12px; border-radius: 0; border-width: 0; justify-content: center; align-items: center; background-color: transparent; }
.settings-button:hover, .settings-button:active, .settings-button.selected:hover { background-color: transparent; }
.settings-button .filled-icon { width: 26px; height: 26px; margin-right: 0; }
.workspace { flex-grow: 1; min-height: 0; padding: 28px 48px 24px 48px; }
.settings-tabs { flex-direction: row; flex-wrap: wrap; margin-bottom: 20px; }
.category-button { border-width: 0; min-width: 112px; height: 36px; flex-direction: row; align-items: center; justify-content: center; margin-bottom: 6px; margin-right: 8px; padding: 0 22px; font-size: 18px; }
.footer { height: 30px; flex-shrink: 0; flex-direction: row; align-items: center; padding-left: 20px; background-color: #17191c; }
.footer .racing-surface { top: -8px; border-radius: 0; }
.footer-hint { color: var(--racing-muted); flex-grow: 1; font-size: 13px; }
.compact .brand { display: none; }
.compact .nav-bar { padding-left: 8px; }
.compact .nav-button { padding-left: 8px; padding-right: 8px; font-size: 16px; }
.compact .resource { margin-left: 10px; }
.compact .resource Label { font-size: 14px; }
.compact .inspection-space { width: 12px; }
.compact .resources { margin-left: 4px; }
.compact .workspace { padding: 20px; }

.settings-body { flex-grow: 1; min-height: 0; border-radius: 12px; overflow: hidden; }
.settings-scroll { flex-grow: 1; padding: 12px 10px 12px 24px; }
.setting-row { flex-direction: row; align-items: center; height: 44px; flex-shrink: 0; border-bottom-width: 1px; border-bottom-color: rgba(138,148,157,0.13); padding: 0 2px; }
.setting-caption { flex-direction: row; align-items: center; flex-grow: 1; flex-basis: 40%; }
.setting-caption Label { font-size: 19px; }
.setting-control { flex-direction: row; align-items: center; flex-basis: 60%; min-width: 0; }
.choice-group { border-radius: 5px; background-color: #13191f; }
.choice-button, .action-button { overflow: hidden; flex-direction: row; align-items: center; justify-content: center; background-color: transparent; color: #e8eaed; border-width: 0; border-radius: 0; font-size: 18px; margin: 0; height: 32px; min-height: 0; padding: 0 12px; }
.choice-button { flex-grow: 1; flex-basis: 0; }
.choice-first { border-top-left-radius: 5px; border-bottom-left-radius: 5px; }
.choice-last { border-top-right-radius: 5px; border-bottom-right-radius: 5px; }
.choice-button.selected { color: white; }
.choice-button:disabled, .setting-toggle:disabled { opacity: 0.45; }
.action-button { min-width: 116px; height: 34px; margin-left: 10px; padding: 0 20px; }
.settings-actions { flex-direction: row; align-items: center; flex-shrink: 0; margin-top: 12px; }
.settings-status { flex-grow: 1; color: var(--racing-accent); font-size: 17px; }
.info-button, .info-button:focus { width: 18px; height: 18px; min-width: 18px; margin-left: 9px; padding: 0; border-radius: 9px; border-width: 1px; border-color: #63707b; background-color: #222a32; color: #bac2ca; font-size: 13px; }
.info-button:active { background-color: #171e25; }
.setting-toggle .unity-toggle__input, .setting-toggle:checked .unity-toggle__input { width: 56px; height: 28px; padding: 0; border-width: 0; background-color: transparent; }
.setting-toggle .unity-toggle__checkmark { display: none; }
.switch-surface { position: absolute; top: 0; right: 0; bottom: 0; left: 0; }
.setting-slider { flex-grow: 1; margin-right: 12px; height: 28px; }
.setting-slider .unity-base-slider__tracker { position: absolute; top: 50%; height: 6px; margin-top: -3px; border-radius: 3px; background-color: #37414b; border-width: 1px; border-color: #59636e; }
.setting-slider .unity-base-slider__dragger { top: 50%; width: 18px; height: 18px; margin-top: -9px; background-color: #e4e8ed; border-width: 1px; border-color: #8e97a0; border-radius: 9px; }
.setting-slider .unity-base-slider__dragger-border { display: none; }
.slider-fill { position: absolute; top: 0; bottom: 0; left: 0; right: 0; border-radius: 3px; overflow: hidden; }
.setting-number { width: 66px; margin-right: 4px; height: 28px; }
.setting-number .unity-base-field__input, .setting-number .unity-base-text-field__input, .setting-text .unity-base-field__input, .setting-text .unity-base-text-field__input { color: #e6e9ed; background-color: #20272e; border-width: 1px; border-top-color: #111820; border-left-color: #111820; border-right-color: #46505b; border-bottom-color: #46505b; border-radius: 4px; padding: 0 8px; }
.setting-number .unity-text-element, .setting-text .unity-text-element { -unity-font-definition: url("project://database/Assets/DragLab/Resources/UI/Fonts/BarlowCondensed-Medium.asset"); font-size: 18px; -unity-text-align: middle-right; }
.setting-text { height: 34px; margin: 0 0 8px 0; }
.setting-text .unity-text-element { -unity-text-align: middle-left; padding-top: 0; padding-bottom: 0; }
.modal-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(0,0,0,0.7); align-items: center; justify-content: center; }
.modal-card { width: 620px; max-width: 90%; max-height: 85%; background-color: transparent; border-width: 0; border-radius: 12px; padding: 20px; }
.modal-heading { flex-direction: row; align-items: center; margin-bottom: 12px; }
.modal-heading Label { flex-grow: 1; font-size: 24px; }
.close-button, .close-button:focus { width: 32px; height: 32px; font-size: 24px; color: white; background-color: #2c333b; border-width: 1px; border-color: #606972; border-radius: 4px; transition-property: background-color, border-color; transition-duration: 0.12s; }
.close-button:hover { background-color: #414b56; border-color: var(--racing-accent); }
.close-button:active { background-color: #20272e; }
.modal-content { flex-shrink: 1; min-height: 32px; }
.modal-content Label { white-space: normal; font-size: 19px; margin-bottom: 6px; }
.modal-actions { flex-direction: row; justify-content: flex-end; margin-top: 20px; flex-shrink: 0; }
.preset-group { background-color: #242b31; border-width: 1px; border-color: #434d57; border-radius: 8px; padding: 4px 12px; margin-bottom: 6px; flex-shrink: 0; }
.preset-group > Label, .settings-group-label { height: 20px; font-size: 17px; color: var(--racing-muted); margin: 0; padding: 0; -unity-text-align: middle-left; translate: 0 -2px; }
.preset-group .setting-row { height: 36px; border-bottom-width: 0; }
.settings-group-label { margin-bottom: 2px; }
.nav-button Label, .category-button Label, .choice-button Label, .action-button Label { height: 100%; margin: 0; padding: 0; -unity-text-align: middle-center; translate: 0 -1px; }
.brand, .resource Label, .footer-hint, .settings-status, .setting-caption Label, .modal-heading Label { margin-top: 0; margin-bottom: 0; padding-top: 0; padding-bottom: 0; -unity-text-align: middle-left; }
.brand, .footer-hint { translate: 0 -2px; }
.settings-status, .modal-heading Label { translate: 0 -1px; }
.setting-number .unity-text-element { padding-top: 0; padding-bottom: 0; }
.info-button, .close-button { -unity-text-align: middle-center; padding-top: 0; padding-bottom: 4px; }
.compact .setting-caption Label { font-size: 18px; }
.compact .choice-button { font-size: 17px; padding-left: 8px; padding-right: 8px; }
.compact .settings-scroll { padding-left: 16px; }
.shell .settings-scrollbar { width: 8px; min-width: 8px; max-width: 8px; margin-left: 12px; }
.shell .scrollbar-arrow { display: none; }
.shell .settings-scrollbar-slider { margin: 0; padding: 0; background-color: #151c23; border-radius: 4px; }
.shell .settings-scrollbar-slider .unity-base-slider__tracker { background-color: #151c23; border-width: 0; }
.shell .settings-scrollbar-slider .unity-base-slider__dragger { background-color: #606c78; border-radius: 4px; border-width: 1px; border-top-color: #8996a2; border-left-color: #788592; border-right-color: #384550; border-bottom-color: #384550; min-height: 28px; }
.category-button, .category-button:hover, .category-button:focus, .category-button:active, .category-button.selected, .category-button.selected:hover,
.settings-button, .settings-button:hover, .settings-button:focus, .settings-button:active, .settings-button.selected, .settings-button.selected:hover,
.choice-button:hover, .choice-button:focus, .choice-button:active, .choice-button.selected:hover,
.action-button, .action-button:hover, .action-button:focus, .action-button:active { background-color: transparent; border-width: 0; }

.shell .settings-scrollbar-slider { width: 8px; min-width: 8px; max-width: 8px; flex-grow: 1; }
.shell .settings-scrollbar-slider .unity-base-slider__drag-container { width: 8px; min-width: 8px; max-width: 8px; margin: 0; padding: 0; }
.shell .settings-scrollbar-slider .unity-base-slider__dragger { width: 8px; min-width: 8px; max-width: 8px; left: 0; }

.reset-control { justify-content: flex-end; }
.reset-action { margin-left: 0; }

.owned-cars-scroll { flex-grow: 1; min-height: 0; }
.owned-cars-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; padding: 2px; }
.owned-car-card { width: 49%; min-height: 238px; margin: 0 0 16px 0; padding: 14px 16px; border-radius: 12px; overflow: hidden; flex-direction: column; align-items: stretch; color: var(--racing-text); font-size: 16px; -unity-text-align: middle-left; }
.owned-car-card, .owned-car-card:hover, .owned-car-card:focus, .owned-car-card:active { background-color: transparent; border-width: 0; }
.car-card-heading { flex-direction: row; align-items: center; }
.car-card-title { flex-grow: 1; flex-shrink: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; font-size: 23px; margin: 0; padding: 0; -unity-text-align: middle-left; translate: 0 -1px; }
.car-current { color: var(--racing-text); font-size: 14px; -unity-text-align: middle-right; }
.car-identity { font-size: 16px; color: var(--racing-muted); margin: 0; padding: 0; }
.car-card-body { flex-direction: row; align-items: center; flex-grow: 1; margin-top: 8px; }
.car-visual { width: 44%; margin-right: 18px; }
.car-preview { width: 100%; height: 90px; overflow: hidden; }
.car-summary { flex-grow: 1; min-width: 0; }
.car-fact { flex-direction: row; justify-content: space-between; }
.car-fact-label { color: var(--racing-muted); margin: 0; padding: 0; }
.car-fact-value { margin: 0; padding: 0; -unity-text-align: middle-right; }
.car-card-stats { font-size: 18px; margin: 0; padding: 0; }
.car-class { font-size: 16px; color: var(--racing-muted); margin: 0; padding: 0; }
.car-condition { font-size: 18px; margin-top: 6px; padding: 0; }
.car-ready { color: #b5cfb5; }
.car-warning { color: #e6bf80; }
.car-critical { color: var(--racing-accent); }
.car-reason { font-size: 16px; color: var(--racing-muted); white-space: normal; margin: 0; padding: 0; }
.car-empty { font-size: 20px; color: var(--racing-muted); }
.car-details-page { flex-grow: 1; min-height: 0; }
.car-details-heading { flex-direction: row; align-items: center; margin-bottom: 16px; flex-shrink: 0; }
.car-back-button { min-width: 40px; width: 40px; padding: 0; margin-left: 0; margin-right: 16px; }
.car-back-button .filled-icon { width: 20px; height: 20px; margin: 0; }
.car-detail-title { font-size: 26px; margin: 0; padding: 0; -unity-text-align: middle-left; flex-shrink: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
.car-rename-button { min-width: 36px; width: 36px; padding: 0; margin-left: 12px; flex-shrink: 0; }
.car-rename-button .filled-icon { width: 18px; height: 18px; margin: 0; }
.modal-content .car-name-fallback { font-size: 16px; color: var(--racing-muted); }
.car-details-frame { flex-grow: 1; min-height: 0; border-radius: 12px; overflow: hidden; }
.car-details-scroll { flex-grow: 1; min-height: 0; padding: 22px 10px 22px 22px; }
.car-details-content .car-card-body { min-height: 180px; }
.car-details-top .car-visual { width: 28%; flex-shrink: 0; }
.car-details-top .car-summary { margin-right: 16px; }
.car-dyno { width: 44%; flex-shrink: 0; }
.car-dyno-legend { flex-direction: row; margin-left: 38px; margin-right: 46px; }
.dyno-legend-group { flex-grow: 1; flex-basis: 0; min-width: 0; padding: 6px 8px; background-color: rgba(15,20,25,0.4); border-width: 1px; border-color: rgba(138,148,157,0.25); border-radius: 6px; }
.dyno-legend-current { margin-right: 6px; }
.dyno-legend-entry { flex-direction: row; align-items: center; }
.dyno-legend-entry Label { flex-shrink: 1; min-width: 0; white-space: normal; }
.dyno-legend-title { color: var(--racing-muted); }
.dyno-line-sample { width: 26px; height: 8px; margin-right: 6px; flex-shrink: 0; }
.car-dyno-legend Label { font-size: 16px; margin: 0; padding: 0; }
.dyno-hover-card { position: absolute; padding: 4px 8px; background-color: #151c23; border-width: 1px; border-color: #606c78; border-radius: 6px; }
.dyno-hover-card Label { font-size: 15px; margin: 0; padding: 0; }
.car-dyno-plot { height: 180px; }
.dyno-axis { position: absolute; font-size: 14px; color: var(--racing-muted); margin: 0; padding: 0; }
.dyno-axis-left { left: 0; width: 34px; -unity-text-align: middle-right; }
.dyno-axis-right { right: 0; width: 42px; }
.dyno-axis-top { top: 12px; }
.dyno-axis-bottom { bottom: 18px; }
.dyno-rpm-ticks { position: absolute; left: 38px; right: 46px; bottom: 0; flex-direction: row; justify-content: space-between; }
.dyno-rpm-ticks Label { font-size: 14px; color: var(--racing-muted); margin: 0; padding: 0; }
.car-details-actions { flex-direction: row; justify-content: flex-end; align-items: center; margin-top: 16px; flex-shrink: 0; }
.car-selection-error { flex-grow: 1; white-space: normal; margin: 0; padding: 0; }
.car-maintenance { margin-top: 14px; }
.maintenance-summary { font-size: 20px; margin-bottom: 10px; }
.maintenance-fluid, .maintenance-engine { flex-direction: row; align-items: center; min-height: 42px; flex-wrap: wrap; border-bottom-width: 1px; border-bottom-color: rgba(138,148,157,0.13); }
.maintenance-fluid-name { width: 92px; font-size: 18px; }
.maintenance-fluid-level { width: 210px; flex-direction: row; align-items: center; }
.maintenance-fluid-level Label { font-size: 17px; margin-left: 0; margin-right: 0; padding-left: 0; padding-right: 0; }
.maintenance-meter { width: 100px; height: 8px; min-height: 0; padding: 0; border-width: 0; margin: 0 14px 0 0; }
.maintenance-meter .unity-progress-bar__title, .maintenance-meter .unity-progress-bar__title-container { display: none; }
.maintenance-meter .unity-progress-bar__container { height: 8px; min-height: 0; padding: 0; border-width: 0; }
.maintenance-meter .unity-progress-bar__background { background-color: #11171d; height: 8px; min-height: 0; padding: 0; border-width: 0; border-radius: 4px; }
.maintenance-meter .unity-progress-bar__progress { background-color: var(--racing-accent); height: 8px; min-height: 0; padding: 0; border-width: 0; border-radius: 4px; }
.maintenance-action { min-width: 90px; height: 30px; font-size: 17px; padding: 0 12px; margin: 4px 0 4px 8px; }
.maintenance-part { flex-direction: row; align-items: center; flex-wrap: wrap; min-height: 60px; border-bottom-width: 1px; border-bottom-color: rgba(138,148,157,0.13); padding: 8px 0; }
.maintenance-part-caption { flex-grow: 1; min-width: 220px; }
.maintenance-part-name { font-size: 18px; }
.maintenance-part-actions { flex-direction: row; flex-wrap: wrap; justify-content: flex-end; }
.maintenance-quantity { flex-direction: row; align-items: center; margin: 12px 0; }
.maintenance-quantity .setting-number { width: 90px; }
.compact .maintenance-meter { width: 75px; }

.car-stats-button { align-self: flex-start; margin-left: 0; margin-top: 10px; min-width: 100px; padding: 0 12px; }
.car-stats-button .filled-icon { width: 16px; height: 16px; margin-right: 8px; }
.native-stats { margin-top: 20px; flex-shrink: 0; }
.stat-filter { align-self: flex-start; margin-left: 0; margin-bottom: 8px; }
.stat-group { border-radius: 8px; overflow: hidden; padding: 8px 12px; }
.stat-group-toggle { justify-content: flex-start; margin: 0; width: 100%; padding: 0 8px; }
.stat-group-toggle .filled-icon { width: 14px; height: 14px; margin-right: 10px; }
.stat-chevron.collapsed { rotate: -90deg; }
.stat-grid { flex-direction: row; flex-wrap: wrap; padding-top: 8px; }
.stat-row { width: 48%; margin-right: 2%; padding: 6px 0; border-bottom-width: 1px; border-bottom-color: rgba(138,148,157,0.13); }
.stat-line { flex-direction: row; align-items: center; justify-content: space-between; min-height: 24px; }
.stat-caption { flex-direction: row; align-items: center; min-width: 0; flex-shrink: 1; }
.stat-caption Label { font-size: 17px; margin: 0; padding: 0; white-space: normal; }
.stat-value { font-size: 17px; margin: 0 0 0 12px; padding: 0; -unity-text-align: middle-right; flex-shrink: 0; }
.stat-text-row .stat-value { max-width: 65%; flex-shrink: 1; white-space: normal; }
.native-stats-comparison .stat-line { flex-wrap: wrap; }
.native-stats-comparison .stat-value { max-width: 100%; flex-shrink: 1; white-space: normal; }
.car-comparison-heading { margin: 0 0 12px 0; padding: 0; white-space: normal; color: var(--racing-muted); }
.stat-help-bubble { position: absolute; width: 360px; max-width: 100%; padding: 12px; border-radius: 8px; }
.stat-help-bubble Label { font-size: 17px; margin: 0; padding: 0; white-space: normal; }
.car-details-top .car-fact-value { flex-shrink: 1; white-space: normal; }
.stat-grid > .stat-group { width: 100%; flex-shrink: 0; margin-top: 8px; }
.stat-bar { height: 5px; margin-top: 6px; border-radius: 3px; background-color: #293039; overflow: hidden; }
.stat-bar-fill { height: 100%; background-color: #63707b; }
.stat-bar-change { position: absolute; top: 0; height: 100%; }
.stat-range { flex-direction: row; justify-content: space-between; }
.stat-range Label { font-size: 12px; color: var(--racing-muted); margin: 0; padding: 0; }
.stat-bar-change.stat-better { background-color: #b5cfb5; }
.stat-bar-change.stat-worse { background-color: var(--racing-accent); }
.stat-bar-change.stat-tradeoff { background-color: #e6bf80; }
.stat-range .stat-better { color: #b5cfb5; }
.stat-range .stat-worse { color: var(--racing-accent); }
.stat-range .stat-tradeoff { color: #e6bf80; }

.owned-car-toolbar { flex-direction: row; align-items: center; flex-shrink: 0; margin-bottom: 16px; }
.owned-car-search { flex-grow: 1; min-width: 120px; margin: 0; position: relative; }
.owned-search-hint { position: absolute; left: 10px; top: 0; bottom: 0; color: var(--racing-muted); font-size: 18px; margin: 0; padding: 0; -unity-text-align: middle-left; }
.owned-car-toolbar .action-button { margin-left: 10px; padding-left: 12px; padding-right: 12px; }
.owned-car-toolbar .owned-query-clear { width: 34px; min-width: 34px; padding: 0; font-size: 23px; }
.owned-car-toolbar .filled-icon { width: 17px; height: 17px; }
.owned-car-count { min-width: 55px; margin: 0 0 0 12px; padding: 0; color: var(--racing-muted); font-size: 17px; -unity-text-align: middle-right; }
.owned-query-group { margin-bottom: 12px; flex-shrink: 0; }
.owned-query-group > Label { font-size: 17px; color: var(--racing-muted); margin: 0 0 4px 0; }
.owned-query-choices { flex-direction: row; margin-bottom: 4px; flex-shrink: 0; }
.owned-query-choices .choice-button { min-width: 0; padding-left: 6px; padding-right: 6px; font-size: 17px; }
.owned-query-range { flex-direction: row; align-items: center; margin-bottom: 8px; flex-shrink: 0; }
.owned-query-range > Label { font-size: 17px; margin: 0 8px 0 0; }
.owned-query-range-title { flex-grow: 1; min-width: 120px; }
.owned-query-range .setting-number { width: 90px; margin-left: 0; margin-right: 10px; }

.car-summary > .car-identity { white-space: normal; }

.garage-pages { flex-direction: row; width: 310px; flex-shrink: 0; margin-bottom: 12px; }
.garage-pages .choice-button { font-size: 18px; }
.dealer-price { font-size: 22px; color: var(--racing-text); margin: 0 0 0 12px; padding: 0; -unity-text-align: middle-right; flex-shrink: 0; }
.dealer-specs { margin-top: 20px; max-width: 720px; }
.dealer-specs .car-fact { min-height: 34px; border-bottom-width: 1px; border-bottom-color: rgba(138,148,157,0.13); }
.dealer-specs .car-fact-label { min-width: 180px; }
.fitted-parts-button { margin-bottom: 8px; }
.fitted-parts-list > .stat-group { margin-bottom: 10px; }
.fitted-part { padding: 8px 0; border-bottom-width: 1px; border-bottom-color: rgba(138,148,157,0.13); }
.fitted-part .car-fact-label { flex-grow: 1; flex-shrink: 1; flex-basis: 65%; margin-right: 12px; }
.fitted-part .car-fact-value { flex-shrink: 1; flex-basis: 35%; }
.modal-content .fitted-part Label { font-size: 17px; margin-bottom: 0; }
.modal-content .fitted-part-slot { font-size: 14px; color: var(--racing-muted); }
.modal-content .fitted-part-fault { color: var(--racing-accent); margin-top: 4px; }
.dealer-includes { margin-top: 16px; white-space: normal; color: var(--racing-muted); font-size: 18px; }
