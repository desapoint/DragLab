.shell {
    flex-grow: 1;
    background-color: #181c21;
    color: #eceef1;
    font-size: 16px;
    -unity-font-definition: url("project://database/Assets/DragLab/Resources/UI/Fonts/BarlowCondensed-Medium.asset");
}
.hidden { display: none; }
.metal-background { position: absolute; left: 0; right: 0; top: 64px; bottom: 30px; overflow: hidden; }
.racing-surface { position: absolute; left: 0; top: 0; right: 0; bottom: 0; overflow: hidden; border-radius: 3px; }
.nav-bar { flex-direction: row; height: 64px; flex-shrink: 0; align-items: stretch; background-color: #17191c; overflow: hidden; }
.brand { -unity-font-definition: url("project://database/Assets/DragLab/Resources/UI/Fonts/BarlowCondensed-BoldItalic.asset"); font-size: 22px; margin-left: 18px; margin-right: 18px; color: #e7454d; -unity-text-align: middle-left; }
.destinations { flex-direction: row; align-items: stretch; }
.nav-button, .category-button, .settings-button {
    margin: 0;
    padding: 8px 12px;
    background-color: transparent;
    color: #dadddf;
    border-width: 1px;
    border-left-color: #53565d;
    border-right-color: #272c32;
    border-top-color: #74767d;
    border-bottom-color: #0b0d10;
    border-radius: 4px;
    overflow: hidden;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.nav-button { flex-direction: row; align-items: center; border-radius: 0; border-width: 0; font-size: 17px; -unity-font-definition: url("project://database/Assets/DragLab/Resources/UI/Fonts/BarlowCondensed-BoldItalic.asset"); }
.nav-button:hover, .category-button:hover, .settings-button:hover { background-color: rgba(255, 255, 255, 0.025); color: white; }
.nav-button:focus, .category-button:focus, .settings-button:focus { border-color: #bd626a; color: white; }
.nav-button:active, .category-button:active, .settings-button:active { background-color: rgba(0, 0, 0, 0.05); }
.nav-button.selected, .category-button.selected, .settings-button.selected { background-color: transparent; color: white; border-top-color: #8d545b; border-bottom-color: #a62c39; }
.nav-button.selected:hover, .category-button.selected:hover, .settings-button.selected:hover { background-color: rgba(255, 255, 255, 0.025); }
.resources { flex-direction: row; flex-grow: 1; justify-content: flex-end; align-items: center; margin-left: 12px; }
.resource { flex-direction: row; align-items: center; margin-left: 16px; }
.resource Label { font-size: 16px; }
.filled-icon { width: 22px; height: 22px; flex-shrink: 0; margin-right: 7px; }
.resource .filled-icon { width: 17px; height: 17px; margin-right: 6px; }
.inspection-space { width: 42px; flex-shrink: 0; }
.settings-button { width: 80px; height: 100%; border-radius: 0; border-width: 0; justify-content: center; align-items: center; background-color: transparent; }
.settings-button:hover, .settings-button:active, .settings-button.selected:hover { background-color: transparent; }
.settings-button .filled-icon { width: 26px; height: 26px; margin-right: 0; }
.workspace { flex-grow: 1; min-height: 0; padding: 28px 48px 24px 48px; }
.settings-tabs { flex-direction: row; flex-wrap: wrap; margin-bottom: 20px; }
.category-button { border-width: 0; min-width: 112px; height: 42px; flex-direction: row; align-items: center; justify-content: center; margin-bottom: 6px; margin-right: 8px; padding: 9px 17px; font-size: 17px; }
.footer { height: 30px; flex-shrink: 0; flex-direction: row; align-items: center; padding-left: 20px; background-color: #17191c; }
.footer .racing-surface { top: -8px; border-radius: 0; }
.footer-hint { color: #afb5be; flex-grow: 1; font-size: 13px; }
.compact .brand { display: none; }
.compact .nav-bar { padding-left: 8px; }
.compact .nav-button { padding-left: 8px; padding-right: 8px; font-size: 16px; }
.compact .resource { margin-left: 10px; }
.compact .resource Label { font-size: 14px; }
.compact .inspection-space { width: 12px; }
.compact .resources { margin-left: 4px; }
.compact .workspace { padding: 20px; }

.settings-body { flex-grow: 1; min-height: 0; border-width: 1px; border-color: #4e565e; border-radius: 12px; overflow: hidden; }
.settings-scroll { flex-grow: 1; padding: 8px 24px; }
.setting-row { flex-direction: row; align-items: center; min-height: 54px; border-bottom-width: 1px; border-bottom-color: rgba(138, 148, 157, 0.15); padding: 8px 2px; }
.setting-caption { flex-direction: row; align-items: center; flex-grow: 1; flex-basis: 40%; }
.setting-caption Label { font-size: 20px; }
.setting-control { flex-direction: row; align-items: center; flex-basis: 60%; min-width: 0; }
.choice-button, .action-button { overflow: hidden; flex-direction: row; align-items: center; justify-content: center; background-color: transparent; color: #e8eaed; border-width: 1px; border-top-color: #59626c; border-left-color: #464e58; border-right-color: #333942; border-bottom-color: #11161c; border-radius: 4px; font-size: 19px; margin: 0; padding: 5px 14px; min-height: 36px; }
.choice-button { flex-grow: 1; flex-basis: 0; }
.choice-button.selected { border-color: #e32936; color: white; }
.choice-button:hover, .action-button:hover { background-color: rgba(255,255,255,0.03); }
.choice-button:focus, .action-button:focus { border-color: #ff8990; }
.choice-button:disabled, .setting-toggle:disabled { opacity: 0.45; }
.action-button { min-width: 128px; min-height: 42px; margin-left: 10px; }
.primary-action { border-width: 0; padding-left: 24px; padding-right: 24px; }
.settings-actions { flex-direction: row; align-items: center; flex-shrink: 0; margin-top: 16px; }
.settings-status { flex-grow: 1; color: #ef9a9f; font-size: 17px; }
.info-button { width: 20px; height: 20px; min-width: 20px; margin-left: 9px; padding: 0; border-radius: 10px; border-width: 1px; border-color: #76818c; background-color: #222a32; color: #c1c7ce; font-size: 14px; }
.setting-toggle .unity-toggle__input { width: 60px; height: 30px; border-radius: 15px; border-width: 1px; border-color: #505b65; background-color: #252d35; padding: 3px; }
.setting-toggle .unity-toggle__checkmark { background-image: none; width: 22px; height: 22px; border-radius: 11px; background-color: #d5d9df; border-width: 1px; border-top-color: white; border-left-color: #f4f6f8; border-bottom-color: #8b929a; border-right-color: #8b929a; margin-left: 0; }
.setting-toggle:checked .unity-toggle__input { background-color: #c71a28; border-color: #ec3e4b; }
.setting-toggle:checked .unity-toggle__checkmark { margin-left: 28px; background-color: #f5f6f8; }
.setting-slider { flex-grow: 1; margin-right: 12px; height: 30px; }
.setting-slider .unity-base-slider__tracker { height: 7px; border-radius: 4px; background-color: #151b21; border-width: 1px; border-top-color: #060a0d; border-bottom-color: #515961; }
.setting-slider .unity-base-slider__dragger { width: 19px; height: 19px; margin-top: -6px; background-color: #e4e8ed; border-width: 1px; border-color: #8e97a0; border-radius: 10px; }
.setting-slider .unity-base-slider__dragger-border { display: none; }
.slider-fill { position: absolute; top: 0; bottom: 0; left: 0; right: 0; border-radius: 4px; }
.setting-number { width: 60px; margin-right: 4px; }
.setting-number .unity-base-field__input, .setting-number .unity-base-text-field__input { color: #e6e9ed; background-color: #151c22; border-width: 1px; border-color: #48515a; border-radius: 3px; font-size: 18px; }
.settings-scroll .unity-scroller { width: 12px; }
.settings-scroll .unity-scroller__slider .unity-base-slider__dragger { background-color: #626c77; border-radius: 4px; }
.modal-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(0,0,0,0.7); align-items: center; justify-content: center; }
.modal-card { width: 620px; max-width: 90%; max-height: 85%; background-color: #151c23; border-width: 1px; border-color: #6d737c; border-left-color: #e82f3d; border-radius: 10px; padding: 20px; }
.modal-heading { flex-direction: row; align-items: center; margin-bottom: 12px; }
.modal-heading Label { flex-grow: 1; font-size: 24px; }
.close-button { width: 32px; height: 32px; font-size: 24px; color: white; background-color: #2c333b; border-width: 1px; border-color: #606972; border-radius: 4px; }
.modal-content { flex-shrink: 1; min-height: 32px; }
.modal-content Label { white-space: normal; font-size: 19px; margin-bottom: 6px; }
.modal-actions { flex-direction: row; justify-content: flex-end; margin-top: 20px; flex-shrink: 0; }
.compact .setting-caption Label { font-size: 18px; }
.compact .choice-button { font-size: 17px; padding-left: 8px; padding-right: 8px; }
.compact .settings-scroll { padding-left: 16px; padding-right: 16px; }

.shell .unity-scroller--vertical { width: 12px; min-width: 12px; max-width: 12px; margin-left: 8px; }
.shell .unity-scroller__low-button, .shell .unity-scroller__high-button { display: none; }
.shell .unity-scroller__slider { margin: 0; padding: 0; background-color: #141b22; border-radius: 5px; }
.shell .unity-scroller__slider .unity-base-slider__tracker { background-color: #141b22; border-width: 0; }
.shell .unity-scroller__slider .unity-base-slider__dragger { background-color: #68727d; border-radius: 5px; border-width: 1px; border-color: #87909a; }
