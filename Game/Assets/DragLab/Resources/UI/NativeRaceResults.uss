.race-results { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: transparent; }
.race-results.hidden { display: none; }
.results-dock { position: absolute; right: 26px; top: 26px; bottom: 272px; width: 414px; max-width: 45%; justify-content: center; }
.timing-paper { flex-grow: 1; flex-shrink: 1; min-height: 0; max-height: 650px; }
.timing-paper-surface { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.slip-scroll { flex-grow: 1; min-height: 0; padding: 23px 13px 25px 23px; }
.timing-paper Label { color: #272b2b; }
.slip-brand { font-size: 30px; -unity-font-definition: url("project://database/Assets/DragLab/Resources/UI/Fonts/BarlowCondensed-BoldItalic.asset"); }
.slip-meta { font-size: 15px; margin-bottom: 14px; }
.slip-outcome { font-size: 32px; border-top-width: 2px; border-top-color: var(--racing-accent); padding-top: 10px; margin-bottom: 10px; }
.slip-row { flex-direction: row; min-height: 38px; align-items: center; border-bottom-width: 1px; border-bottom-color: #d0cfc6; }
.slip-row Label { margin: 0; padding: 0; min-width: 0; flex-shrink: 1; }
.slip-caption { flex-basis: 40%; font-size: 17px; }
.slip-number { flex-basis: 30%; font-size: 23px; -unity-text-align: middle-right; }
.slip-column-head .slip-number { font-size: 15px; }
.slip-note { white-space: normal; font-size: 16px; margin-top: 12px; margin-bottom: 10px; }
.timing-paper .unity-foldout__text { color: #272b2b; }
.timing-paper .action-button Label { color: #e8eaed; }
.slip-actions { height: 34px; flex-shrink: 0; margin-top: 12px; flex-direction: row; justify-content: flex-end; }
.slip-actions .action-button { flex-grow: 1; min-width: 0; margin-left: 8px; }
.compact .results-dock { right: 18px; top: 18px; bottom: 262px; width: 390px; }
.compact .slip-scroll { padding: 16px 10px 20px 18px; }
.compact .slip-row { min-height: 32px; }
.compact .slip-number { font-size: 21px; }
