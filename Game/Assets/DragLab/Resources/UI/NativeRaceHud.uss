.race-hud.hidden { display: none; }
.race-hud {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-color: transparent;
    color: var(--racing-text);
    -unity-font-definition: url("project://database/Assets/DragLab/Resources/UI/Fonts/BarlowCondensed-Medium.asset");
    --gauge-face: #10161b;
    --gauge-rim: #697078;
    --gauge-tick: #e0e4e7;
}
.race-dials { position: absolute; left: 22px; bottom: 22px; flex-direction: row; align-items: flex-end; }
.analog-gauge { width: 226px; height: 226px; margin-right: 14px; }
.rpm-gauge { width: 254px; height: 254px; }
.gauge-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.gauge-number { position: absolute; width: 32px; height: 22px; padding: 0; margin: 0; -unity-text-align: middle-center; font-size: 18px; color: var(--gauge-tick); }
.gauge-red-number { color: var(--racing-accent); }
.gauge-value { position: absolute; left: 25%; right: 25%; top: 63%; height: 36px; font-size: 30px; -unity-text-align: middle-center; }
.gauge-unit { position: absolute; left: 15%; right: 15%; top: 79%; height: 22px; font-size: 14px; color: var(--racing-muted); -unity-text-align: middle-center; }
.gauge-factor { position: absolute; left: 25%; right: 25%; top: 31%; height: 20px; font-size: 13px; color: var(--racing-muted); -unity-text-align: middle-center; }
.race-dashboard { position: absolute; top: auto; left: 0; right: 0; bottom: 0; height: 178px; }
.race-shifter { position: absolute; left: auto; top: auto; right: 24px; bottom: 15px; width: 220px; height: 202px; }
.shifter-gear { position: absolute; left: 0; right: 0; top: 20px; height: 128px; font-size: 76px; -unity-text-align: middle-center; }
.sequential-selector .shifter-gear { right: auto; top: auto; width: 40px; height: 40px; font-size: 24px; }
.shifter-type { position: absolute; left: 0; right: 0; bottom: 8px; height: 25px; font-size: 17px; color: var(--racing-muted); -unity-text-align: middle-center; }
.gate-number { position: absolute; width: 30px; height: 20px; font-size: 15px; color: var(--racing-muted); -unity-text-align: middle-center; }
.race-phase { position: absolute; bottom: 76px; left: 44%; right: 260px; height: 30px; font-size: 20px; -unity-text-align: middle-center; }
.race-warning { position: absolute; bottom: 36px; left: 44%; right: 260px; min-height: 28px; font-size: 18px; white-space: normal; color: var(--racing-accent); -unity-text-align: middle-center; }
.compact .analog-gauge { width: 190px; height: 190px; margin-right: 10px; }
.compact .rpm-gauge { width: 214px; height: 214px; }
.compact .race-dials { left: 16px; bottom: 22px; }
.compact .gauge-number { font-size: 16px; }
.compact .gauge-value { font-size: 27px; height: 31px; }

.race-pause-button { position: absolute; top: 18px; right: 24px; min-width: 42px; width: 42px; height: 34px; padding: 0; margin: 0; align-items: center; justify-content: center; }
.race-pause-button .filled-icon { width: 18px; height: 18px; margin: 0; }
.race-ready-button { position: absolute; top: 18px; right: 80px; min-width: 100px; margin: 0; }
.race-ready-button.hidden { display: none; }

.race-shifter.h-pattern { height: 230px; }
.h-pattern .shifter-gear { right: auto; top: auto; width: 92px; height: 92px; font-size: 57px; }

.race-pause-button, .race-pause-button:hover, .race-pause-button:active { background-image: none; }

.gauge-shift-lamp { left: 44%; right: auto; top: 19%; bottom: auto; width: 12%; height: 12%; }
.gauge-shift-lamp.hidden { display: none; }
